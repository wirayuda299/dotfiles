{
    "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.library": [
    "/usr/share/nvim/runtime/lua",
    "/usr/share/nvim/runtime/lua/vim/lsp",
 "${3rd}/love2d/library"
  ],
  "Lua.completion.enable": true,
    "diagnostics.globals": [
        "vim",
        "progress_reporter",
        "jit"
    ],
    "diagnostics.disable": [
        "need-check-nil",
        "missing-fields",
        "different-requires",
        "inject-field",
        "undefined-doc-name"
    ]
}
